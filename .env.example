# --- Supabase (dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
# new-style publishable key (sb_publishable_…) or legacy anon JWT — either name works
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=                 # server only — the sb_secret_… key (never expose)
SUPABASE_SERVICE_ROLE_KEY=           # legacy name for the same secret key — either works
DATABASE_URL=                        # Supabase session-mode connection string (port 5432)

# --- Resend (email) ---
RESEND_API_KEY=
EMAIL_FROM="Stay Assistant <hello@mail.yourdomain.com>"

# --- App ---
APP_URL=http://localhost:3000

# --- Inngest (cloud dashboard keys; dev server needs no key) ---
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=
INNGEST_DEV_SERVER_URL=http://127.0.0.1:8288

# --- AI (any OpenAI-compatible provider) ---
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=                      # omit for OpenAI; set to swap providers
